import glob
import os
import pandas as pd
import numpy as np

# ==========================================
# Folder containing reference CSV files
# ==========================================

folder = "../output"

files = sorted(glob.glob(os.path.join(folder, "reference_*.csv")))

print("Total Reference CSV Files :", len(files))

summary = []

# ==========================================
# Process each CSV
# ==========================================

for file in files:

    df = pd.read_csv(file)

    # Calculate displacement magnitude
    displacement = np.sqrt(df["dx"]**2 + df["dy"]**2)

    avg_disp = displacement.mean()
    max_disp = displacement.max()

    # Extract target image number
    # Example: reference_0003_0045.csv

    name = os.path.basename(file)

    parts = name.replace(".csv", "").split("_")

    reference = int(parts[1])
    target = int(parts[2])

    summary.append([
        reference,
        target,
        avg_disp,
        max_disp
    ])

# ==========================================
# Save Summary
# ==========================================

summary_df = pd.DataFrame(
    summary,
    columns=[
        "Reference",
        "Target",
        "Average_Displacement",
        "Maximum_Displacement"
    ]
)

summary_df.to_csv(
    "../output/reference_displacement_summary.csv",
    index=False
)

print(summary_df.head())

print("\nSaved : reference_displacement_summary.csv")